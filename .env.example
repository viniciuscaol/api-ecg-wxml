ECG_BIND_IP=127.0.0.1
ECG_PORT=8000
# Opcional para uso local. Preencha ao disponibilizar a API na rede.
ECG_API_KEY=
# Opcional: origens permitidas para frontend em outro domínio/porta, separadas por vírgulas.
# Prefira um proxy de backend para não expor uma chave compartilhada ao navegador.
ECG_CORS_ORIGINS=
